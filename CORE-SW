hostname CORE-SW
no ip domain lookup
ip domain name lab.local
ip routing
vlan database
vlan 10
vlan 20
vlan 30
vlan 99
exit
interface GigabitEthernet0/0
 description TO-PERIM-FW
 ip address 10.0.1.2 255.255.255.0
 no shutdown
interface GigabitEthernet1/1
 description TRUNK-TO-USER-SW
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 1,10,99,1002-1005
 duplex full
 speed 1000
 no shutdown
interface GigabitEthernet1/2
 description TRUNK-TO-HR-SW
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 1,20,99,1002-1005
 duplex full
 speed 1000
 no shutdown
interface GigabitEthernet1/3
 description TRUNK-TO-DMZ-SW
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 1,30,99,1002-1005
 duplex full
 speed 1000
 no shutdown
interface GigabitEthernet1/4
 description TO-IDS-MGMT
 switchport mode access
 switchport access vlan 99
 duplex full
 speed 1000
 no shutdown
interface GigabitEthernet1/5
 description SPAN-DEST-TO-IDS
 duplex full
 speed 1000
 no shutdown
interface Vlan10
 ip address 192.168.10.1 255.255.255.0
 no shutdown
interface Vlan20
 ip address 192.168.20.1 255.255.255.0
 no shutdown
interface Vlan30
 ip address 192.168.30.1 255.255.255.0
 no shutdown
interface Vlan99
 ip address 192.168.99.1 255.255.255.0
 no shutdown
ip route 0.0.0.0 0.0.0.0 10.0.1.1
ip access-list extended QUAR-HOSTS
vlan access-map AUTO-QUAR 10
 match ip address QUAR-HOSTS
 action drop
vlan access-map AUTO-QUAR 20
 action forward
crypto key generate rsa modulus 1024
ip ssh version 2
username admin privilege 15 secret cisco123
line vty 0 4
 login local
 transport input ssh
monitor session 1 source interface GigabitEthernet1/1 - 3
monitor session 1 destination interface GigabitEthernet1/5
end
write memory
